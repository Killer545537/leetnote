{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "expressions": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "original": {
                        "type": "string",
                        "description": "The exact candidate expression from the input list"
                    },
                    "kind": {
                        "type": "string",
                        "enum": ["math", "mixed", "code"],
                        "description": "math: only math notation; mixed: math that mentions code values; code: program code"
                    }
                },
                "required": [
                    "original",
                    "kind"
                ],
                "additionalProperties": false,
                "x-order": [
                    "original",
                    "kind"
                ]
            }
        }
    },
    "required": [
        "expressions"
    ],
    "additionalProperties": false,
    "x-order": [
        "expressions"
    ]
}
